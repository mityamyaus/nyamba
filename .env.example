# Set only on the local server, never in dist or browser storage.
# Without SMS_RU_API_ID, the app explicitly uses demo codes and does not verify phone ownership.
SMS_RU_API_ID=
SMS_RU_SENDER=
# Optional map provider overrides:
MEAL_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
MEAL_OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
MEAL_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Server deployment: DNS name only, no scheme. Copy this file to .env.
DOMAIN=nyamba.example.ru
